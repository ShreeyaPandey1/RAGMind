# =====================================================================
# RAGMind — AI Knowledge Engine Environment Configuration
# =====================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg2://ragmind:ragmind@localhost:5432/ragmind_db
ALLOW_SQLITE_FALLBACK=true

# AI / LLM Model Configuration (OpenAI or OpenAI-compatible endpoint)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_GENERATION_TOKENS=1500

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Ingestion & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# Retrieval Configuration
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_THRESHOLD=0.35
ENABLE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
